{
  "info": {
    "name": "UaiiPonto API - Completo",
    "description": "Coleção completa de testes para a API UaiiPonto com todas as rotas de autenticação, time entries e relatórios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"organization\": \"Empresa X\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Time Entries",
      "item": [
        {
          "name": "Check-In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Chegada no escritório\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/time-entries/check-in",
              "host": ["{{base_url}}"],
              "path": ["time-entries", "check-in"]
            }
          }
        },
        {
          "name": "Check-Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Saída do escritório\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/time-entries/check-out",
              "host": ["{{base_url}}"],
              "path": ["time-entries", "check-out"]
            }
          }
        },
        {
          "name": "Get Today Entries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/time-entries/today",
              "host": ["{{base_url}}"],
              "path": ["time-entries", "today"]
            }
          }
        },
        {
          "name": "Get History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/time-entries/history?days=30&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["time-entries", "history"],
              "query": [
                {
                  "key": "days",
                  "value": "30"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get User Date Range Entries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/time-entries/user/{{user_id}}/range?start_date=2026-04-01&end_date=2026-04-10",
              "host": ["{{base_url}}"],
              "path": ["time-entries", "user", "{{user_id}}", "range"],
              "query": [
                {
                  "key": "start_date",
                  "value": "2026-04-01"
                },
                {
                  "key": "end_date",
                  "value": "2026-04-10"
                }
              ]
            }
          }
        },
        {
          "name": "List All Entries (Admin/Manager)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/time-entries",
              "host": ["{{base_url}}"],
              "path": ["time-entries"]
            }
          }
        },
        {
          "name": "Delete Entry",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/time-entries/1",
              "host": ["{{base_url}}"],
              "path": ["time-entries", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Relatórios",
      "item": [
        {
          "name": "Daily Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reports/daily?date=2026-04-10",
              "host": ["{{base_url}}"],
              "path": ["reports", "daily"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-04-10"
                }
              ]
            }
          }
        },
        {
          "name": "Weekly Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reports/weekly?start_date=2026-04-04",
              "host": ["{{base_url}}"],
              "path": ["reports", "weekly"],
              "query": [
                {
                  "key": "start_date",
                  "value": "2026-04-04"
                }
              ]
            }
          }
        },
        {
          "name": "Monthly Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reports/monthly?month=04&year=2026",
              "host": ["{{base_url}}"],
              "path": ["reports", "monthly"],
              "query": [
                {
                  "key": "month",
                  "value": "04"
                },
                {
                  "key": "year",
                  "value": "2026"
                }
              ]
            }
          }
        },
        {
          "name": "Export Report - PDF",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reports/export/pdf?date=2026-04-10&type=daily",
              "host": ["{{base_url}}"],
              "path": ["reports", "export", "pdf"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-04-10"
                },
                {
                  "key": "type",
                  "value": "daily"
                }
              ]
            }
          }
        },
        {
          "name": "Export Report - Excel",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reports/export/excel?date=2026-04-10&type=daily",
              "host": ["{{base_url}}"],
              "path": ["reports", "export", "excel"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-04-10"
                },
                {
                  "key": "type",
                  "value": "daily"
                }
              ]
            }
          }
        },
        {
          "name": "Export Report - CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reports/export/csv?date=2026-04-10&type=daily",
              "host": ["{{base_url}}"],
              "path": ["reports", "export", "csv"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-04-10"
                },
                {
                  "key": "type",
                  "value": "daily"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Utils",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            }
          }
        }
      ]
    }
  ]
}
